{
  "name": "typelesslocal",
  "private": true,
  "version": "1.1.64",
  "type": "module",
  "description": "Local Whisper speech-to-text desktop app",
  "keywords": [
    "speech-to-text",
    "stt",
    "llm",
    "tauri",
    "desktop",
    "voice-input"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sudo-engr/TypelessLocal.git"
  },
  "homepage": "https://github.com/sudo-engr/TypelessLocal",
  "bugs": {
    "url": "https://github.com/sudo-engr/TypelessLocal/issues"
  },
  "author": "TypelessLocal contributors",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev-dioxus.mjs",
    "build": "node scripts/build-dioxus.mjs --release && tsc && vite build",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:ui:check": "node scripts/check-design-rules.mjs",
    "check:ui": "cargo check --manifest-path frontend/Cargo.toml --target wasm32-unknown-unknown --locked",
    "test:ui": "cargo test --manifest-path frontend/Cargo.toml --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.2",
    "@tauri-apps/plugin-deep-link": "^2.2",
    "@tauri-apps/plugin-global-shortcut": "^2.2",
    "@tauri-apps/plugin-opener": "^2.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "better-auth": "1.6.25",
    "framer-motion": "^11.18",
    "i18next": "^24.2",
    "kubai-icons": "0.10.0",
    "lucide-react": "^0.460",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.4",
    "zustand": "^5.0"
  },
  "devDependencies": {
    "@eslint/core": "0.17.0",
    "@eslint/js": "^10.0.1",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/jest-dom": "^6.6",
    "@testing-library/react": "^16.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "cn": "0.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^25.0",
    "prettier": "^3.5",
    "tailwindcss": "^4.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  }
}
